# Copie para .env e ajuste
PORT=3335
DATABASE_URL=postgres://condominio:condominio@127.0.0.1:5433/condominio
JWT_SECRET=2acbf7efbc9754492d49a8c6c5e2332a79efb1bc12831573c6a55a78d1722a7d
# 64 caracteres hex (32 bytes) usados para cifrar as URLs RTSP no banco: openssl rand -hex 32
CAMERA_KEY=4198033b4e0a0c5390b3039b1ad04a015f1e0d6cc7e3f59bd27dc0b60ddfca6e
WEB_ORIGIN=http://localhost:5174
UPLOAD_DIR=./uploads

# Gateway de vídeo (go2rtc atrás de proxy que valida o token curto)
GATEWAY_PUBLIC_URL=http://localhost:1984
CAMERA_TOKEN_TTL_SECONDS=120
# Token do agente do gateway (infra/gateway-agent.mjs) para informar câmeras online/offline
GATEWAY_TOKEN=troque-este-token-do-gateway

# Cobrança via PSP (Asaas). Sem chave, a API funciona em modo manual (baixa pelo tesoureiro).
PSP_PROVIDER=asaas
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
PSP_WEBHOOK_TOKEN=troque-este-token
